{% render 'rebigulator_styles' %}
<div class="h--full rebigulator">
  {% render 'rebigulator_header', instance_title: instance_title, date: date, compact: false %}
  <div class="pt--2 gap--[8px] rebigulator__body">
    {% if ok == false %}
      {% render 'rebigulator_error', error: error %}
    {% else %}
      {% render 'rebigulator_challenge',
        imageUrl: imageUrl,
        quote: quote,
        answer: answer,
        qr_size: 5,
        compact: false,
        portrait: false
      %}
    {% endif %}
  </div>
</div>
