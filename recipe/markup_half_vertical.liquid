{% render 'rebigulator_styles' %}
<div class="h--full rebigulator rebigulator--compact rebigulator--portrait">
  {% render 'rebigulator_header', instance_title: instance_title, date: date, compact: true %}
  <div class="pt--1 gap--[5px] rebigulator__body">
    {% if ok == false %}
      {% render 'rebigulator_error', error: error %}
    {% else %}
      {% render 'rebigulator_challenge',
        imageUrl: imageUrl,
        quote: quote,
        answer: answer,
        qr_size: 3,
        compact: true,
        portrait: true
      %}
    {% endif %}
  </div>
</div>
