{% template rebigulator_styles %}
<style>
  @font-face {
    font-family: "Akbar";
    src: url("https://rebigulator.org/fonts/akbar-webfont.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
  }

  .rebigulator {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: sans-serif;
  }

  .rebigulator__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    border: 3px solid var(--black);
  }

  .rebigulator .rebigulator__brand {
    font-family: "Akbar", sans-serif;
    font-weight: 400;
    letter-spacing: 0;
  }

  .rebigulator__identity {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .rebigulator__logo {
    width: 32px;
    height: 32px;
  }

  .rebigulator__date {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rebigulator__body {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    gap: 8px;
  }

  .rebigulator__challenge {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
  }

  .rebigulator__frame {
    display: block;
    width: 100%;
    min-height: 0;
    flex: 1 1 auto;
    border: 4px solid var(--black);
  }

  .rebigulator__quote {
    flex: 0 0 auto;
    border: 3px solid var(--black);
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .rebigulator__reveal {
    display: flex;
    flex: 0 0 142px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--black);
  }

  .rebigulator__reveal svg {
    display: block;
    width: 118px;
    height: 118px;
  }

  .rebigulator__reveal-label {
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .rebigulator--compact .rebigulator__header {
    padding: 3px 7px;
  }

  .rebigulator--compact .rebigulator__brand {
    font-size: 18px;
  }

  .rebigulator--compact .rebigulator__identity {
    gap: 4px;
  }

  .rebigulator--compact .rebigulator__logo {
    width: 22px;
    height: 22px;
  }

  .rebigulator--compact .rebigulator__date {
    font-size: 9px;
  }

  .rebigulator--compact .rebigulator__body {
    gap: 5px;
    padding-top: 5px;
  }

  .rebigulator--compact .rebigulator__quote {
    padding: 3px 5px;
    font-size: 11px;
  }

  .rebigulator--compact .rebigulator__reveal {
    flex-basis: 86px;
    padding: 4px;
  }

  .rebigulator--compact .rebigulator__reveal svg {
    width: 70px;
    height: 70px;
  }

  .rebigulator--compact .rebigulator__reveal-label {
    font-size: 8px;
  }

  .rebigulator--portrait .rebigulator__body {
    flex-direction: column;
  }

  .rebigulator--portrait .rebigulator__reveal {
    flex-basis: auto;
    flex-direction: row;
    gap: 8px;
  }

  .rebigulator--portrait .rebigulator__reveal svg {
    width: 72px;
    height: 72px;
  }

  .rebigulator__error {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    border: 4px solid var(--black);
    font-weight: 900;
    text-transform: uppercase;
  }

</style>
{% endtemplate %}

{% template rebigulator_header %}
<div class="px--2 py--1 bg--cyan-60 1bit:bg--white 2bit:bg--white rebigulator__header">
  <div class="rebigulator__identity">
    <img
      class="image image-dither image--contain rebigulator__logo"
      src="https://rebigulator.org/logo.png"
      alt=""
    >
    <span class="text--large text--black rebigulator__brand">
      {{- instance_title | default: 'Rebigulator' -}}
    </span>
  </div>
  <span class="text--small text--black rebigulator__date">Daily challenge - {{ date }}</span>
</div>
{% endtemplate %}

{% template rebigulator_challenge %}
<div class="rebigulator__challenge">
  <img
    class="image image-dither image--contain rebigulator__frame"
    src="{{ imageUrl }}"
    alt="Daily Rebigulator frame"
  >
  <div
    class="px--2 py--1 bg--yellow-40 1bit:bg--white 2bit:bg--white text--base text--black text--center rebigulator__quote"
  >
    "{{ quote }}"
  </div>
</div>
<div class="p--2 text--center rebigulator__reveal">
  {{ answer | qr_code: qr_size, 'm' }}
  <span class="mt--1 text--small text--black rebigulator__reveal-label">
    Scan to reveal<br>
    the episode
  </span>
</div>
{% endtemplate %}

{% template rebigulator_error %}
<div class="p--4 bg--yellow-40 text--large text--black text--center rebigulator__error">
  {{ error | default: "Unable to load today's Rebigulator challenge." }}
</div>
{% endtemplate %}
