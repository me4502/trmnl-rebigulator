{% template rebigulator_styles %}
<style>
  @font-face {
    font-family: "Akbar";
    src: url("https://rebigulator.org/fonts/akbar-webfont.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
  }

  .rebigulator {
    display: flex;
    flex-direction: column;
  }

  .rebigulator__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    border: 3px solid var(--black);
  }

  .rebigulator .rebigulator__brand {
    font-family: "Akbar", sans-serif;
    letter-spacing: 0;
  }

  .rebigulator__identity {
    display: flex;
    align-items: center;
  }

  .rebigulator__date {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rebigulator__body {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
  }

  .rebigulator__challenge {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: column;
  }

  .rebigulator__frame {
    display: block;
    min-height: 0;
    flex: 1 1 auto;
    border: 4px solid var(--black);
  }

  .rebigulator__quote {
    flex: 0 0 auto;
    border: 3px solid var(--black);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .rebigulator__reveal {
    display: flex;
    flex: 0 0 142px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--black);
  }

  .rebigulator__reveal-label {
    line-height: 1.05;
    text-transform: uppercase;
  }

  .rebigulator--compact .rebigulator__reveal {
    flex-basis: 86px;
  }

  .rebigulator--portrait .rebigulator__body {
    flex-direction: column;
  }

  .rebigulator--portrait .rebigulator__reveal {
    flex-basis: auto;
    flex-direction: row;
  }

  .rebigulator__error {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    border: 4px solid var(--black);
    text-transform: uppercase;
  }

</style>
{% endtemplate %}

{% template rebigulator_header %}
<div
  class="px--2 py--1 bg--cyan-60 1bit:bg--white 2bit:bg--white rebigulator__header"
>
  <div class="{% if compact %}gap--[4px]{% else %}gap--[7px]{% endif %} rebigulator__identity">
    <img
      class="image image-dither image--contain {% if compact %}w--[22px] h--[22px]{% else %}w--[32px] h--[32px]{% endif %} rebigulator__logo"
      src="https://rebigulator.org/logo.png"
      alt=""
    >
    <span
      class="{% if compact %}text--base{% else %}text--large{% endif %} text--black font--regular rebigulator__brand"
    >
      {{- instance_title | default: 'Rebigulator' -}}
    </span>
  </div>
  <span class="text--small text--black font--bold rebigulator__date">Daily challenge - {{ date }}</span>
</div>
{% endtemplate %}

{% template rebigulator_challenge %}
<div class="gap--[6px] rebigulator__challenge">
  <img
    class="image image-dither image--contain w--full rebigulator__frame"
    src="{{ imageUrl }}"
    alt="Daily Rebigulator frame"
  >
  <div
    class="{% if compact %}px--1{% else %}px--2{% endif %} py--1 bg--yellow-40 1bit:bg--white 2bit:bg--white {% if compact %}text--small{% else %}text--base{% endif %} text--black text--center font--bold rebigulator__quote"
  >
    "{{ quote }}"
  </div>
</div>
<div
  class="{% if compact %}p--1{% else %}p--2{% endif %} text--center {% if portrait %}gap--[8px]{% endif %} rebigulator__reveal"
>
  {% capture qr_svg %}{{ answer | qr_code: qr_size, 'm' }}{% endcapture %}
  {% if portrait %}
    {% assign qr_svg_start = '<svg class="w--[72px] h--[72px]"' %}
  {% elsif compact %}
    {% assign qr_svg_start = '<svg class="w--[70px] h--[70px]"' %}
  {% else %}
    {% assign qr_svg_start = '<svg class="w--[118px] h--[118px]"' %}
  {% endif %}
  {{ qr_svg | replace_first: '<svg', qr_svg_start }}
  <span class="mt--1 text--small text--black font--bold rebigulator__reveal-label">
    Scan to reveal<br>
    the episode
  </span>
</div>
{% endtemplate %}

{% template rebigulator_error %}
<div class="p--4 bg--yellow-40 text--large text--black text--center font--bold rebigulator__error">
  {{ error | default: "Unable to load today's Rebigulator challenge." }}
</div>
{% endtemplate %}
