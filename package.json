{
  "name": "trmnl-rebigulator",
  "version": "1.0.0",
  "description": "TRMNL Recipe helper for the Rebigulator daily challenge.",
  "keywords": [],
  "license": "MIT",
  "author": "Madeline Miller <@the_me4502>",
  "type": "module",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "oxlint . src/**/*",
    "fmt": "oxfmt --write . src/**/*",
    "fmt:check": "oxfmt --check . src/**/*",
    "types": "wrangler types --env-file .env.worker",
    "types:check": "wrangler types --env-file .env.worker --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "prune": "knip"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "knip": "^6.29.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "sharp": {
      "built": true
    },
    "workerd": {
      "built": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.17.0"
}
